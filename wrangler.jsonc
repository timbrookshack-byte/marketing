{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketing360",
  "main": ".open-next/worker.js",

  // Pinned rather than floating: the runtime's behaviour is part of the build,
  // and a date that moves on its own is a deployment that changes without a
  // commit.
  "compatibility_date": "2026-11-01",

  // Next's server code reaches for a handful of Node built-ins even when the
  // application does not. Without this the Worker fails to start.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Both are enabled by default, and wrangler warns when they are left
  // implicit. Stated here so a deployment cannot quietly change what is
  // reachable.
  //
  // Preview URLs are off deliberately: they give every deployed version its
  // own hostname, each serving this same Worker and the same D1 data. Access
  // policies are bound to a hostname, so leaving them on would put unguarded
  // doors beside the protected one.
  "workers_dev": true,
  "preview_urls": false,

  // The portal's real address. Declared here rather than added in the
  // dashboard so the hostname travels with the deployment: Cloudflare creates
  // the DNS record and issues the certificate from this, and a rebuilt account
  // ends up at the same place without anyone remembering a click.
  //
  // workers.dev stays on for now as a way back in if this misbehaves. It can
  // be switched off once the custom domain is proven; Access protects the
  // Worker itself, so every hostname it answers on is behind the same policy.
  "routes": [
    {
      "pattern": "shack360marketing.app",
      "custom_domain": true
    }
  ],

  "vars": {
    // Read by instrumentation to decide which database driver to install.
    "RUNTIME": "cloudflare",

    // Where OAuth redirects come back to. Not a secret, so it lives here
    // rather than in a secret. Without it the code falls back to
    // http://localhost:3000 and every platform callback breaks.
    "APP_BASE_URL": "https://shack360marketing.app"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marketing360",
      // Filled in from `wrangler d1 create marketing360`.
      "database_id": "8504622f-6f5f-4153-8b32-fa2f1ce0b8b8"
    }
  ]
}
