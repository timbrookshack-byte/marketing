# ---------------------------------------------------------------- core
# Must match the redirect URIs registered with each ad platform.
# Callbacks are {APP_BASE_URL}/api/connectors/{platform}/callback
APP_BASE_URL=http://localhost:3000

# AES-256-GCM key for OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
# Required in production — the app refuses to start without it there.
CREDENTIALS_KEY=

# Optional. Defaults to ./data/marketing360.db
# DATABASE_PATH=/var/lib/marketing360/marketing360.db

# ------------------------------------------------------------------ AI
# Enables portfolio analysis, the creative workshop and the analyst chat.
# Everything else — dashboards, rule findings, budget optimiser — works without it.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# --------------------------------------------------------- ad platforms
# Fill in only the platforms you actually use. A connector becomes
# connectable in the UI as soon as its client id and secret are present.

# Google Ads. Access is granted to the Google Cloud project these OAuth
# credentials belong to — developer tokens were sunset on 9 September 2026 and
# the header is now ignored. Apply for Basic access from your Cloud project's
# "Google Ads API Overview" page; with brand verification it is automated and
# approves in minutes.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Optional, only if you still hold a token from before the sunset:
# GOOGLE_ADS_DEVELOPER_TOKEN=
# The API version is discovered automatically — Google sunsets each one about a
# year after release, so pinning it here is only for forcing a specific version.
# GOOGLE_ADS_API_VERSION=v26
# Only when reaching the account through a manager (MCC) account. This can also
# be set per connection from the Google Ads card, which is the easier place:
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Ads (Facebook + Instagram)
META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=
# META_ADS_API_VERSION=v21.0

# OpenAI Ads — PROVISIONAL. See the README: this connector is written against a
# declared contract rather than published docs. Verify the field names in
# EXPECTED_SHAPE (src/lib/connectors/openai-ads.ts) before trusting live numbers.
OPENAI_ADS_API_KEY=
# OPENAI_ADS_API_BASE=https://api.openai.com/v1/ads

# LinkedIn Ads
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
# LINKEDIN_ADS_API_VERSION=202411

# TikTok Ads
TIKTOK_ADS_CLIENT_ID=
TIKTOK_ADS_CLIENT_SECRET=
# TIKTOK_ADS_API_VERSION=v1.3

# --- OAuth is wired for these, but the reporting mapping is not written yet.
# Setting them makes the connector connectable; syncing reports a clear
# "not implemented" error naming what is still needed.
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
REDDIT_ADS_CLIENT_ID=
REDDIT_ADS_CLIENT_SECRET=
X_ADS_CLIENT_ID=
X_ADS_CLIENT_SECRET=
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
PINTEREST_ADS_CLIENT_ID=
PINTEREST_ADS_CLIENT_SECRET=
SNAPCHAT_ADS_CLIENT_ID=
SNAPCHAT_ADS_CLIENT_SECRET=

# ------------------------------------------------- revenue and analytics
# This half is what makes the other half trustworthy. Without real orders,
# every channel is judged on its own marking.

# Shopify — the shop domain is stored per connection, not here.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Stripe — a restricted key with read access to charges is enough.
STRIPE_API_KEY=

# WooCommerce — REST API key pair from the store's settings.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Google Analytics 4 — the fallback when there is no store API.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=

# ---------------------------------------------- concept inspiration
# Competitor ad research. Every one of these is optional: without any of them
# you can still paste in ads by hand, and the traction scoring works on those.
#
# Note on what is possible here — no public source exposes a competitor's
# performance. There is no legal way to see another retailer's ROAS or CTR.
# What these give you is which ads are running and for how long, which is the
# proxy the module scores on.

# Meta Ad Library. Needs a user access token from an app whose owner has
# completed Meta's identity confirmation.
# IMPORTANT: ad_type=ALL returns ordinary commercial ads only when the search
# region is EU or UK. Elsewhere the archive is limited to political and
# social-issue ads, so a purely domestic US competitor returns nothing.
META_AD_LIBRARY_TOKEN=

# TikTok Commercial Content API. Access is granted through TikTok's research
# programme, not an advertiser account. Returns metadata only — no video files.
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=

# LinkedIn Ad Library. An access token with the r_ads_library scope.
LINKEDIN_AD_LIBRARY_TOKEN=

# Google's Ads Transparency Center has NO official API — it is a consumer web
# app with no developer surface. To cover Google, subscribe to a licensed
# provider (SerpApi, SearchApi and similar) and put your own key here. This
# portal does not scrape Google directly.
AD_INTEL_PROVIDER_KEY=
# AD_INTEL_PROVIDER_URL=https://serpapi.com/search
# AD_INTEL_PROVIDER_FLAVOUR=serpapi
